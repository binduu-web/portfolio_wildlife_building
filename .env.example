# GEMINI_API_KEY: Required for server-side Gemini AI image classification.
# Obtain a key from Google AI Studio and set it in your environment or deployment secrets.
# NEVER expose this key in client-side code or commit real keys to version control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional HTTP port for the Express server (defaults to 3000).
PORT="3000"

# APP_URL: The public URL where the application is hosted.
APP_URL="MY_APP_URL"
